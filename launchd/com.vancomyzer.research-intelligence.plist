<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.vancomyzer.research-intelligence</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>cd /Volumes/VANCOMYZER/vancomyzer-agents &amp;&amp; /usr/bin/python3 /Volumes/VANCOMYZER/vancomyzer-agents/scripts/research_intelligence_daemon.py once</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vanclab</string>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/vanclab/Library/Logs/com.vancomyzer.research-intelligence.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/vanclab/Library/Logs/com.vancomyzer.research-intelligence.err.log</string>
  </dict>
</plist>
