# -----------------------------------------------------------------------------
# Vancomyzer website: example environment settings
#
# Documents the open-access launch, analytics and calculator rate-limit
# settings only. Other required settings (NextAuth, Stripe, email, database)
# are not listed here. This file contains no real values; every line below is
# commented out, so copying it changes nothing until you uncomment a line.
#
# Real values belong in the hosting provider's environment settings, or in
# .env.local for local development (.env.local is git-ignored; never commit it).
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the page code by `next build`.
# Changing one takes effect ONLY after the site is rebuilt and redeployed; a
# restart alone is not enough. Variables without the prefix are read by the
# server at runtime.
# -----------------------------------------------------------------------------


# --- Open access (launch period) ---------------------------------------------
# Free calculator for every visitor, no sign-in required. ON unless set to
# exactly "false". Set to false (then rebuild) to restore required sign-in and
# paid tiers. See src/lib/openAccess.ts.
# NEXT_PUBLIC_OPEN_ACCESS=true


# --- Privacy-first, cookie-free analytics --------------------------------------
# Site-specific Plausible is the supported provider. Without its script URL, no
# analytics script is loaded and no analytics requests are made.
# See src/components/Analytics.tsx.

# Required: site-specific Plausible script copied from the website's settings.
# Legacy script.js, domain-only configuration and Umami are unsupported: they
# do not share the tested browser-side privacy boundary. Admin usage status
# reports missing/unsupported/disabled configurations; production logs a warning.
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/pa-XXXXXXXXXXXXXXXX.js
# Build-time kill switch. Set true for tests/previews; local hosts are also blocked.
# NEXT_PUBLIC_ANALYTICS_DISABLED=true

# --- Admin usage dashboard (server-only) ---------------------------------------
# Shared dashboard link shown at /admin/dashboard/usage. Server-only ON PURPOSE
# (no NEXT_PUBLIC_ prefix): a shared link grants read access to the stats and
# must never be shipped in public page code. Read per request (no rebuild needed).
#   Plausible: Site settings > Visibility > Shared links. Leave the password
#              blank (password-protected links cannot be embedded). The page
#              adds embed=true and theme=light automatically.
#   Umami:     edit the website > Share URL. Self-hosted Umami may need
#              ALLOWED_FRAME_URLS to include this site for the embedded view.
# ANALYTICS_DASHBOARD_URL=https://plausible.io/share/example.com?auth=XXXXXXXXXXXX


# --- Anonymous calculator rate limit -------------------------------------------
# Limits anonymous POST /api/calculate per client network address; excess
# requests get HTTP 429 with a Retry-After header. Read at request time.
# Missing, non-numeric or < 1 values fall back to the defaults shown.
# See src/lib/rateLimit.ts.
# CALC_RATE_LIMIT_MAX=300
# CALC_RATE_LIMIT_WINDOW_MS=600000

# --- Market intelligence (server-only; never NEXT_PUBLIC) ----------------------
# ANTHROPIC_API_KEY=  # Set privately in the hosting service; never commit a key.
# MARKET_INTEL_MODEL=claude-sonnet-4-6
# MARKET_INTEL_DIR=/data/market_intelligence
# REDDIT_ACCESS_TOKEN=  # Only for approved Reddit Data API use; optional.
# Without approved Reddit access, collection skips Reddit and reports the gap.
# Manual dashboard collection does not send email. Requires a persistent Node
# server; job status uses SQLite leases and reports interrupted jobs as failed.
