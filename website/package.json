{
  "name": "vancomyzer-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-10000}",
    "lint": "next lint",
    "test": "npm run test:pk && npm run test:oracle && npm run test:horizon && npm run test:hmac && npm run test:baa && npm run test:cases && npm run test:safety-pattern && npm run test:predictive && npm run test:report-suite && npm run test:study-readiness && npm run test:market-intel",
    "test:pk": "node --import tsx src/lib/pk/__tests__/existingRegimen.integration.test.ts && node --import tsx src/lib/pk/__tests__/initialRegimen.integration.test.ts && node --import tsx src/lib/pk/__tests__/credibleBand.test.ts && node --import tsx src/lib/pk/__tests__/loadingDose.test.ts",
    "test:report-suite": "node --import tsx src/lib/pk/__tests__/reportVerificationSuite.test.ts && node --import tsx src/lib/pk/__tests__/selectedRegimenReport.test.ts",
    "test:oracle": "node --import tsx src/lib/pk/__tests__/oracle/oracle.test.ts",
    "test:hmac": "node --import tsx src/lib/pilotApplication/__tests__/hmac.fixture.test.ts",
    "test:baa": "node --import tsx src/lib/baa/__tests__/baa.test.ts",
    "test:cases": "node --import tsx scripts/verify-cases.ts",
    "test:safety-pattern": "bash scripts/check-safety-pattern.sh",
    "test:predictive": "node --import tsx scripts/verify-predictive-performance.ts",
    "analysis:band-coverage": "node --import tsx scripts/verify-band-coverage.ts --report",
    "test:horizon": "node --import tsx src/lib/pk/__tests__/exposureHorizon.regression.test.ts",
    "test:study-readiness": "node --import tsx src/lib/pk/__tests__/studyReadiness.test.ts && node --import tsx scripts/research/cli.test.ts",
    "typecheck:research": "tsc -p tsconfig.research.json",
    "test:market-intel": "node --import tsx src/lib/scraper/__tests__/analyst.test.ts && node --import tsx src/lib/scraper/__tests__/collection.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "fhirclient": "^2.6.3",
    "jose": "^6.2.2",
    "next": "14.2.35",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "otplib": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.0",
    "sharp": "^0.34.5",
    "stripe": "^17.7.0",
    "zod": "^4.4.2"
  },
  "overrides": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
